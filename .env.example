SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/markdown_system?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

FILE_UPLOAD_PATH=${user.home}/markdown-uploads/images/
FILE_MAX_SIZE=5242880
FILE_URL_PREFIX=/api/images

JWT_SECRET=your-jwt-secret-key-replace-this-with-random-string
JWT_EXPIRATION=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
